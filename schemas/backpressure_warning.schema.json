{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backpressure_warning.schema.json",
  "title": "Backpressure Warning Payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subscriber": {"type": "string"},
    "drops": {"type": "integer", "minimum": 1},
    "queued": {"type": "integer", "minimum": 0},
    "queue_max": {"type": "integer", "minimum": 1},
    "topics": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["subscriber", "drops", "queued", "queue_max"]
}
